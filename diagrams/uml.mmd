classDiagram
    %% Final design: matches pawpal_system.py. The Phase 1 draft is kept in uml_draft.mmd.

    class Owner {
        +str name
        +int daily_budget_minutes
        +List~str~ preferred_categories
        +time day_start
        +time day_end
        +List~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +list_pets() List~Pet~
        +all_tasks() List~Task~
        +find_task(task_id) Tuple~Pet, Task~
        +to_dict() dict
        +from_dict(data)$ Owner
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task) None
        +remove_task(task_id) bool
        +get_task(task_id) Task
        +list_tasks() List~Task~
        +to_dict() dict
        +from_dict(data)$ Pet
    }

    class Task {
        +str id
        +str series_id
        +str description
        +datetime scheduled_at
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +str category
        +bool completed
        +end_time() datetime
        +overlaps(other) bool
        +next_occurrence(after) Task
        +mark_complete(completed_at) Task
        +to_dict() dict
        +from_dict(data)$ Task
    }

    class Scheduler {
        +Owner owner
        +add_task(pet_name, task) List~Conflict~
        +complete_task(task_id, completed_at) Task
        +sort_by_time(tasks) List~Task~
        +filter_tasks(pet_name, completed, on_date) List~Task~
        +detect_conflicts() List~Conflict~
        +conflicts_for(task_id) List~Conflict~
        +build_daily_plan(day, budget_minutes) DailyPlan
        +find_next_available_slot(duration_minutes, window_start, window_end) datetime
        +pet_name_of(task_id) str
    }

    class Conflict {
        <<frozen dataclass>>
        +Task first
        +Task second
        +str first_pet
        +str second_pet
        +int overlap_minutes
        +cross_pet() bool
    }

    class DailyPlan {
        <<frozen dataclass>>
        +date day
        +int budget_minutes
        +List~PlanEntry~ selected
        +List~PlanEntry~ skipped
        +minutes_used() int
        +minutes_free() int
    }

    class PlanEntry {
        <<frozen dataclass>>
        +Task task
        +str pet_name
        +str reason
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
        +from_str(value)$ Priority
    }

    class Frequency {
        <<enumeration>>
        NONE
        DAILY
        WEEKLY
        +interval() timedelta
    }

    class JsonPersistence {
        <<module functions>>
        +save_owner(owner, path) None
        +load_owner(path) Owner
    }

    class PawPalError {
        <<exception>>
    }
    class DuplicateError {
        <<exception>>
    }
    class NotFoundError {
        <<exception>>
    }
    class PersistenceError {
        <<exception>>
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : reads tasks via
    Scheduler ..> Conflict : returns
    Scheduler ..> DailyPlan : builds
    DailyPlan "1" *-- "0..*" PlanEntry : selected / skipped
    PlanEntry --> Task
    Conflict --> "2" Task : involves
    Task --> Priority
    Task --> Frequency
    Task ..> Task : next_occurrence creates
    JsonPersistence ..> Owner : saves / loads
    PawPalError <|-- DuplicateError
    PawPalError <|-- NotFoundError
    PawPalError <|-- PersistenceError
